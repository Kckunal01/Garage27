# ─── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://garage27.in

# ─── Supabase ────────────────────────────────────────────────────────────
# Public (anon) values are safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used by route handlers for
# quote / service / order writes and private storage uploads.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_UPLOADS_BUCKET=references

# ─── Payments ────────────────────────────────────────────────────────────
# razorpay | mock   (mock is refused in production)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Analytics ───────────────────────────────────────────────────────────
# Comma separated adapters: console,datalayer,beacon
NEXT_PUBLIC_ANALYTICS_ADAPTERS=datalayer
